# PostgreSQL and public URL
DATABASE_URL="postgresql://teamflow:teamflow@localhost:5442/teamflow?schema=public"
APP_URL="http://127.0.0.1:3000"
# Redis is required in production for distributed rate limits.
REDIS_URL="redis://localhost:6382"
# Browser WebSocket endpoint. Leave empty to use the local SSE adapter.
NEXT_PUBLIC_REALTIME_WS_URL=""
# Bind the WebSocket service privately; expose /realtime through a TLS proxy.
REALTIME_PORT="3001"
REALTIME_HOST="127.0.0.1"
# Optional SMTP. Development without SMTP writes messages to .data/outbox.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="TeamFlow <no-reply@example.com>"
# Optional Google OAuth. Configure APP_URL/api/auth/google/callback as redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Required in production. Development stores uploads in .data/attachments.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
